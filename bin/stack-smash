#!/bin/bash

SCRIPTVERSION=1.0
SCRIPTNAME=$(basename "$0")

CATBIN=/usr/bin/cat

function log_error() {
  echo "ERROR: $*" >&2
}

function check_root() {
  if [[ ${EUID} -ne 0 ]]; then
    log_error "This script must be run with root privileges."
    echo ""
    echo "Please run: sudo $0 $*"
    exit 1
  fi
}

function show_usage() {
  ${CATBIN} << EOF
Usage: ${SCRIPTNAME} v${SCRIPTVERSION}
EXAMPLES:
  ${SCRIPTNAME} enable
  ${SCRIPTNAME} disable
  ${SCRIPTNAME} -v|--version
  ${SCRIPTNAME} -h|--help
EOF
}

function show_version() {
  echo ${SCRIPTNAME} v${SCRIPTVERSION}
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case ${1} in
      enable|disable)
        COMMAND=${1}
        shift # past argument
        ;;
      -v|--version)
        ARG_VERSION=YES
        shift # past argument
        ;;
      -h|--help)
        ARG_HELP=YES
        shift # past argument
        ;;
      *)
        echo "Unknown option ${1}"
        show_usage
        exit 1
        ;;
    esac
  done
}

main() {
  parse_args "$@"

  if [ "${ARG_HELP}" == "YES" ]; then
    show_usage
    exit 0
  elif [ "${ARG_VERSION}" == "YES" ]; then
    show_version
    exit 0
  elif [[ -z "${COMMAND}" ]]; then
    echo status
    exit 0
  fi

  check_root "$@"

  if [ "${COMMAND}" == "enable" ]; then
    echo enable
  elif [ "${COMMAND}" == "disable" ]; then
    echo disable
  fi
}

main "$@"

